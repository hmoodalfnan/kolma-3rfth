# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app does not start without these three.
# Set all three in Vercel (Production, Preview, Development), then redeploy.
# Values come from Supabase → Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL, NOT your Vercel URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The publishable / anon key (starts with sb_publishable_ or eyJ...).
# Safe to expose — it is protected by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The secret / service-role key (starts with sb_secret_ or eyJ...).
# Server-only. Never prefix this with NEXT_PUBLIC_ — that ships it to every browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────

# Internal email domain used to synthesize Supabase Auth identities.
# Never shown to users and never receives mail. Changing it after accounts exist
# breaks every login until the stored addresses are updated — see supabase/README.md.
AUTH_EMAIL_DOMAIN=tracker.internal

# Passkey / biometric sign-in. Bare hostname, no scheme and no path.
# Inferred automatically on Vercel; only needed for a custom domain.
WEBAUTHN_RP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL TEST HARNESS ONLY — do NOT set these in Vercel.
#
# These are read exclusively by `npm test -- tests/db`. The application ignores
# them completely: setting these instead of the three REQUIRED variables above
# will leave every page failing with a server error.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_KEY=
