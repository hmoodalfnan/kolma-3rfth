# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Never expose to the browser, and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Internal email domain used to synthesize Supabase Auth identities.
# Never shown to users and never receives mail. Changing it after accounts exist
# breaks every login until the stored addresses are updated — see supabase/README.md.
AUTH_EMAIL_DOMAIN=tracker.internal

# Passkey / biometric sign-in. Must be the bare hostname, no scheme and no path.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL, so it is only
# needed for a custom domain or local testing over https.
WEBAUTHN_RP_ID=

# Optional: enables the env-gated database integration tests.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_KEY=
